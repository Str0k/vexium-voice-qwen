# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# === Deepgram (required) ===
DEEPGRAM_API_KEY=
# Voice Agent endpoint. EU customers: wss://agent.api.eu.deepgram.com/v1/agent/converse
# DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse

# === AWS Bedrock — Claude as the brain (required for Phase 1) ===
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Use whatever Claude model you ENABLED in Bedrock (the id is passed through as-is).
# Example (verified in Deepgram docs):
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# === Agent behavior ===
BUSINESS_NAME=Vexium Dental
BUSINESS_TYPE=dental clinic
AGENT_LANGUAGE=en
LLM_TEMPERATURE=0.7
# Default greeting opens with a spoken AI disclosure (US bot-disclosure laws). If you
# override GREETING, KEEP an "asistente virtual con inteligencia artificial" clause:
# GREETING=Gracias por llamar a Vexium Dental, le atiende Sofía, su asistente virtual con inteligencia artificial. ¿En qué le puedo ayudar?

# === Deepgram models — Phase 1 defaults: English Nova-3 STT + Aura-2 English TTS ===
DG_LISTEN_MODEL=nova-3
DG_LISTEN_VERSION=
DG_LANGUAGE_HINTS=
DG_SPEAK_MODEL=aura-2-thalia-en
# >>> Phase 2 (bilingual EN/ES): set
#     DG_LISTEN_MODEL=flux-general-multi
#     DG_LISTEN_VERSION=v2
#     DG_LANGUAGE_HINTS=en,es
#     DG_SPEAK_MODEL=aura-2-estrella-es   (Mexican Spanish, featured female voice)
#     Alternatives: aura-2-javier-es (Mexican male), aura-2-selena-es (LatAm, codeswitching EN/ES)

# === Twilio (Phase 3 — NOT needed yet; use a US number) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === ElevenLabs TTS (BYO-TTS inside Deepgram; needs paid plan for commercial use) ===
# Activates automatically once ELEVENLABS_VOICE_ID is set; else Deepgram Aura-2 is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # Spanish/default voice id
ELEVENLABS_VOICE_ID_EN=      # optional English voice id (swapped in for English turns)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_LANGUAGE_CODE=     # optional; LEAVE BLANK (recommended) for bilingual auto-detect.
                             # Pinning =es makes the greeting's English tail sound ES-accented.

# === Restaurant demo vertical (optional — has sensible defaults in restaurant.py) ===
# The web demo switches business via the call widget; the bridge reads ?v=restaurant.
# REST_NAME=Vexium Cocina
# REST_GREETING=Gracias por llamar a Vexium Cocina, le atiende Valentina, su asistente virtual con inteligencia artificial. ¿En qué le puedo ayudar?
# REST_SPECIALS=la pesca del día es robalo a la veracruzana...
# Distinct "anfitriona" voices for the restaurant (fall back to the shared voices above):
# ELEVENLABS_VOICE_ID_REST=        # Spanish host voice id
# ELEVENLABS_VOICE_ID_EN_REST=     # English host voice id

# === Fallback LLM: managed Anthropic via Deepgram (if Bedrock access has issues) ===
ANTHROPIC_API_KEY=

# === Qwen / DashScope (Hackathon Phase) ===
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BRAIN_MODEL=qwen3-max
QWEN_REALTIME_WS=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash

# === Alibaba Cloud Tablestore (conversation memory) ===
TABLESTORE_ENDPOINT=
TABLESTORE_INSTANCE=
TABLESTORE_ACCESS_KEY_ID=
TABLESTORE_ACCESS_KEY_SECRET=

# === Stripe (payments) ===
STRIPE_API_KEY=
STRIPE_SUCCESS_URL=https://demo.example.com/paid

# === SMS Provider ===
SMS_PROVIDER=none
ALIBABA_SMS_ACCESS_KEY_ID=
ALIBABA_SMS_ACCESS_KEY_SECRET=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=

# === Cal.com scheduling ===
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# === Staff / Notifications ===
STAFF_PHONE=

# === Voice backend selector ===
VOICE_BACKEND=deepgram
