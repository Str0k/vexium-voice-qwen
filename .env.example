# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
#
# Minimum to demo: ONLY `DASHSCOPE_API_KEY` — that enables the text mode (Qwen brain +
# Qwen TTS), the Qwen judge, bookings (simulated calendar), metrics and the dashboard.
# Everything else upgrades a fallback into the real integration.

# === Qwen / Alibaba Cloud Model Studio (REQUIRED) ===
# Get a key at https://modelstudio.console.alibabacloud.com/ (intl). Free tier works.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BRAIN_MODEL=qwen3-max
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
# (reserved for a future full-Qwen realtime voice path)
QWEN_REALTIME_WS=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_MODEL=qwen3-asr-flash-realtime

# === Alibaba Cloud Tablestore (persistence; falls back to in-memory if unset) ===
# Create an instance, then run: python scripts/provision_tablestore.py
TABLESTORE_ENDPOINT=
TABLESTORE_INSTANCE=
TABLESTORE_ACCESS_KEY_ID=
TABLESTORE_ACCESS_KEY_SECRET=

# === SMS (confirmations, deposit links, reminders, staff alerts) ===
# alibaba | twilio | none (none = messages are skipped, flow still completes)
SMS_PROVIDER=none
ALIBABA_SMS_ACCESS_KEY_ID=
ALIBABA_SMS_ACCESS_KEY_SECRET=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STAFF_PHONE=            # where escalation alerts go

# === Voice mode (optional — Deepgram Voice Agent with Qwen as its think step) ===
DEEPGRAM_API_KEY=
# DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse   # EU: agent.api.eu.deepgram.com
DG_LISTEN_MODEL=flux-general-multi
DG_LISTEN_VERSION=v2
DG_LANGUAGE_HINTS=en,es
DG_EOT_THRESHOLD=0.7
DG_EAGER_EOT_THRESHOLD=0.45
DG_EOT_TIMEOUT_MS=6000
DG_KEYTERMS=Sofía,limpieza,blanqueamiento,ortodoncia,cleaning,whitening,appointment
DG_SPEAK_MODEL=aura-2-selena-es   # fallback TTS voice when ElevenLabs is unset

# === ElevenLabs TTS (optional; BYO-TTS inside Deepgram, per-language voices) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # Spanish voice id (e.g. Regina MX)
ELEVENLABS_VOICE_ID_EN=       # English voice id (swapped in for English turns)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_LANGUAGE_CODE=     # leave blank for bilingual auto-detect
# Optional distinct restaurant-host voices:
# ELEVENLABS_VOICE_ID_REST= / ELEVENLABS_VOICE_ID_EN_REST=

# === Calendar (optional — real Cal.com booking; simulated if unset) ===
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# === Payments (optional — real Stripe checkout links; simulated if unset) ===
STRIPE_API_KEY=
STRIPE_SUCCESS_URL=https://demo.example.com/paid

# === Business identity (optional overrides) ===
BUSINESS_NAME=Vexium Dental
BUSINESS_TYPE=dental clinic
LLM_TEMPERATURE=0.7
# GREETING=...   (keep the spoken AI disclosure if you override it)
# REST_NAME=Vexium Cocina / REST_GREETING=... / REST_SPECIALS=...

# === Web frontend (web/.env.local) ===
# NEXT_PUBLIC_BRIDGE_URL=      # blank = same-origin /ws (or localhost:8000 in dev)
# NEXT_PUBLIC_BRIDGE_HTTP=     # blank = same-origin (or localhost:8000 in dev)
