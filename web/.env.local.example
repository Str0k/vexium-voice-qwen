# Copy to `.env.local` for local dev, and set the same var in Vercel for production.
#
# URL of the voice bridge (server.py). The browser opens a WebSocket to it.
#   Local dev (bridge on your laptop):   ws://localhost:8000/ws
#   Via ngrok (so a deployed frontend can reach your laptop): wss://<id>.ngrok-free.app/ws
#   Production (bridge on AWS):           wss://api.vexiumai.com/ws
NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8000/ws
